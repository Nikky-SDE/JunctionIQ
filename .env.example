# Junction IQ Environment Configuration
# Copy this file to .env and adjust values for your local or deployed environment.
# Never commit .env to version control.

# --- Frontend Proxy & Dev Server ---
PORT=3000
HOST=0.0.0.0
PUBLIC_PORT=80
API_INTERNAL_URL=http://127.0.0.1:4000

# --- API Gateway ---
API_PORT=4000
API_HOST=0.0.0.0
ENGINE_MODE=auto
ENGINE_URL=http://127.0.0.1:7070
CORS_ORIGIN=
MAX_RESULTS=50
STATIONS_FILE=data/processed/stations.json
TIMETABLE_PATH=data/processed/timetable.json

# --- C++ Routing Engine (Docker / Linux) ---
ENGINE_HOST=0.0.0.0
ENGINE_PORT=7070
ENGINE_THREADS=8
ADMIN_PORT=7071
WORKER_ID=engine
SHUTDOWN_GRACE_MS=3000
MIN_TRANSFER_MINUTES=30
MAX_TRANSFERS_INTERNAL=10
TOP_K=50
K_NODE=0
SEARCH_HORIZON_MINUTES=5760
MAX_LABELS=500000

# --- Data Preprocessing Scripts ---
RAW_DATA_DIR=train_data
PROCESSED_DIR=data/processed
REPORTS_DIR=data/reports
CLEAN_POLICY=correct
